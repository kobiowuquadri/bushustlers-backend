<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{subject}}</title>
</head>
<body style="margin:0;padding:0;background:#F7F4EA;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#122A23;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#F7F4EA;padding:32px 12px;">
    <tr>
      <td align="center">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background:#FFFFFF;border-radius:20px;overflow:hidden;">
          <tr>
            <td style="background:#08281F;padding:24px 32px;">
              <img src="{{frontendUrl}}/brand/bushustlers-logo-dark.png" width="164" height="32" alt="Bushustlers" style="display:block;border:0;height:32px;width:164px;">
            </td>
          </tr>
          <tr>
            <td style="padding:32px;font-size:16px;line-height:1.6;">
              {{body}}
            </td>
          </tr>
          <tr>
            <td style="padding:20px 32px;border-top:1px solid #DCE2DA;font-size:13px;line-height:1.5;color:#4E6259;">
              You are receiving this email because of activity on your {{appName}} account. This is an automated message.<br>
              &copy; {{currentYear}} {{appName}}
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
