# ---- App ------------------------------------------------------------------------------------
NODE_ENV=development
# development | sandbox | production. Defaults to production when NODE_ENV=production.
#   development: local only (dev mailbox, demo tools, relaxed cookies)
#   sandbox:     hosted test environment (secure cookies, requires FRONTEND_URL, demo tools allowed)
#   production:  live money only (requires PAYMENTS_PROVIDER=busha, BUSHA_ENV=production, ALLOW_LIVE_PAYMENTS=true)
APP_ENV=development
PORT=5000
APP_NAME=Bushustlers
# Where checkout links and email links point
FRONTEND_URL=http://localhost:3000
# Comma-separated browser origins allowed to call the API (defaults to FRONTEND_URL)
CORS_ORIGIN=http://localhost:3000
# Reverse proxies in front of the API (0 locally, 1 on Render; add 1 if requests also pass through the Next.js proxy)
TRUST_PROXY=0
SUPPORT_EMAIL=

# ---- Sessions -----------------------------------------------------------------------------------
# Long random string (32+ characters; required outside development)
SECRET_KEY=
ACCESS_TOKEN_EXPIRES_IN=15m
SESSION_TTL_DAYS=7
# Defaults to true outside development; secure cookies use the __Host- prefix
# COOKIE_SECURE=

# ---- Database (MySQL 8) -----------------------------------------------------------------------------
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# Keep low on small hosted plans (each API instance opens up to this many connections)
DB_POOL_MAX=5
# Apply pending additive migrations at startup (otherwise run `npm run db:migrate`)
DB_MIGRATE_ON_START=false

# ---- Payments -----------------------------------------------------------------------------------
# demo  = explicit, clearly labelled simulation (never real payment instructions)
# busha = real Busha API (all three Busha keys below are required)
PAYMENTS_PROVIDER=demo
BUSHA_ENV=sandbox
# Sandbox defaults to https://api.sandbox.busha.so; production must be set explicitly
BUSHA_BASE_URL=
BUSHA_PUBLIC_KEY=
BUSHA_SECRET_KEY=
# From Busha dashboard > Settings > Developer tools > Webhooks (URL: <API>/api/v1/webhooks/busha)
BUSHA_WEBHOOK_SECRET=
# Asset:network pairs offered at checkout; only Busha-documented pairs are accepted
BUSHA_STABLECOIN_OPTIONS=USDT:TRX,USDT:BSC,USDC:BASE
BUSHA_TIMEOUT_MS=15000
# Required (with APP_ENV=production) before live payments are allowed
ALLOW_LIVE_PAYMENTS=false
# Merchant-side simulation tools (never available with APP_ENV=production)
DEMO_TOOLS=true
# Display rate used only by the demo provider, labelled as a demo rate
DEMO_NGN_PER_USD=1500.00
PAYMENT_LINK_TTL_HOURS=72
RECONCILE_INTERVAL_SECONDS=60

# ---- Proposed pricing (paid by the business, deducted from settlement) ----------------------------
PLATFORM_FEE_NGN_BPS=100
PLATFORM_FEE_NGN_CAP_MINOR=100000
PLATFORM_FEE_STABLECOIN_BPS=150

# ---- Email (queued and sent by a background worker) ------------------------------------------------
# Brevo (preferred). The sender must be verified in Brevo; if "Authorised IPs" is on, allow the API host's IP.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Bushustlers
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
# Or Gmail SMTP with an app password
EMAIL_USER=
EMAIL_PASSWORD=
# Development only: without an email provider, emails are captured and shown at /dev/mailbox
DEV_MAILBOX=true

# ---- Cloudinary (optional, unused by the payment flows) -----------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
